// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model User {
  id            Int       @id @default(autoincrement())
  fullname      String    @map("fullname") @db.VarChar(100)
  email         String    @unique @db.VarChar(100)
  phone         String    @unique @db.VarChar(20)
  dateOfBirth   DateTime  @map("date_of_birth") @db.Date
  fluencyLevel  String    @map("fluency_level") @db.VarChar(2)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  isVerified    Boolean   @default(false) @map("is_verified")
  isActive      Boolean   @default(true) @map("is_active")
  role          String    @default("student") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")

  otpCodes          OtpCode[]
  wallet            Wallet?
  sessions          Session[]
  transactions      Transaction[]
  fluencyHistory          UserFluencyHistory[] @relation("UserFluencyHistory")
  changedFluencyHistories UserFluencyHistory[] @relation("UserFluencyHistoryChangedBy")
  sessionAuditLog         SessionAuditLog[]

  @@map("users")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  phone     String   @db.VarChar(20)
  email     String?  @db.VarChar(100)
  otpCode   String   @map("otp_code") @db.VarChar(6)
  purpose   String   @default("login") @db.VarChar(20)
  isUsed    Boolean  @default(false) @map("is_used")
  expiresAt DateTime @map("expires_at") @db.Timestamp(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, otpCode])
  @@index([expiresAt])
  @@map("otp_codes")
}

model Wallet {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique @map("user_id")
  balance    Decimal   @default(0.00) @db.Decimal(10, 2)
  currency   String    @default("USD") @db.VarChar(3)
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Session {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  sessionDate       DateTime  @map("session_date") @db.Date
  startTime         DateTime  @map("start_time") @db.Time(0)  // FIXED: Changed from String to DateTime
  endTime           DateTime  @map("end_time") @db.Time(0)    // FIXED: Changed from String to DateTime
  durationMinutes   Int       @default(60) @map("duration_minutes")
  language          String    @default("English") @db.VarChar(50)
  reasonForLearning String?   @map("reason_for_learning") @db.Text
  studentNotes      String?   @map("student_notes") @db.Text
  status            String    @default("pending") @db.VarChar(20)
  meetUrl           String?   @map("meet_url") @db.VarChar(500)
  meetingId         String?   @map("meeting_id") @db.VarChar(100)
  meetingPassword   String?   @map("meeting_password") @db.VarChar(50)
  amountPaid        Decimal   @map("amount_paid") @db.Decimal(10, 2)
  paymentStatus     String    @default("pending") @map("payment_status") @db.VarChar(20)
  requestedAt       DateTime  @default(now()) @map("requested_at") @db.Timestamp(3)
  approvedAt        DateTime? @map("approved_at") @db.Timestamp(3)
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamp(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
  adminNotes        String?   @map("admin_notes") @db.Text

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  sessionAuditLog SessionAuditLog[]

  @@index([userId, status])
  @@index([sessionDate])
  @@index([status])
  @@map("sessions")
}

model Transaction {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  sessionId       Int?      @map("session_id")
  transactionType String    @map("transaction_type") @db.VarChar(20)
  amount          Decimal   @db.Decimal(10, 2)
  balanceBefore   Decimal   @map("balance_before") @db.Decimal(10, 2)
  balanceAfter    Decimal   @map("balance_after") @db.Decimal(10, 2)
  description     String?   @db.VarChar(255)
  referenceId     String?   @map("reference_id") @db.VarChar(100)
  paymentMethod   String?   @map("payment_method") @db.VarChar(50)
  status          String    @default("pending") @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  completedAt     DateTime? @map("completed_at") @db.Timestamp(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@map("transactions")
}

model UserFluencyHistory {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  oldLevel  String?   @map("old_level") @db.VarChar(2)
  newLevel  String    @map("new_level") @db.VarChar(2)
  changedBy Int?      @map("changed_by")
  reason    String?   @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)

  user    User  @relation("UserFluencyHistory", fields: [userId], references: [id], onDelete: Cascade)  // FIXED: Named relation
  changer User? @relation("UserFluencyHistoryChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)  // FIXED: Opposite relation

  @@index([userId, createdAt])
  @@map("user_fluency_history")
}

model SessionAuditLog {
  id        Int       @id @default(autoincrement())
  sessionId Int       @map("session_id")
  userId    Int       @map("user_id")
  action    String    @db.VarChar(50)
  oldStatus String?   @map("old_status") @db.VarChar(50)
  newStatus String?   @map("new_status") @db.VarChar(50)
  notes     String?   @db.Text
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_audit_log")
}

model SessionPricing {
  id              Int       @id @default(autoincrement())
  language        String    @db.VarChar(50)
  durationMinutes Int       @map("duration_minutes")
  price           Decimal   @db.Decimal(10, 2)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  @@unique([language, durationMinutes])
  @@map("session_pricing")
}