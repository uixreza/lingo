// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model User {
  id            Int       @id @default(autoincrement())
  fullname      String    @db.VarChar(100)
  email         String?    @unique @db.VarChar(100)
  phone         String    @unique @db.VarChar(11)
  dateOfBirth   DateTime?  @map("date_of_birth") @db.Date
  avatarSeed    String?   @map("avatar_seed")
  IsPro         Boolean   @map("is_pro") @default(true)
  fluencyLevel  FluencyLevel    @map("fluency_level") 
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  isVerified    Boolean   @default(false) @map("is_verified")
  isActive      Boolean   @default(true) @map("is_active")
  role          Role      @default(Client) 
  badges        Badges[]  @default([Pro])
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")
  certifications   Certifications[]
  wallet        Wallet?
  otp           OTP?
  sessions          Session[]
  transactions      Transaction[]
  sessionAuditLog   SessionAuditLog[]
  notifications     Notification[]
  tickets           Ticket[]
  sentFriends       Friend[] @relation("SentFriendRequests")
  receivedFriends   Friend[] @relation("ReceivedFriendRequests")
  posts             Post[]
  notebookNotes     NotebookNote[]

  @@map("users")
}

enum FriendStatus {
  Pending
  Accepted
}

model Friend {
  id         Int          @id @default(autoincrement())
  senderId   Int          @map("sender_id")
  receiverId Int          @map("receiver_id")
  status     FriendStatus @default(Pending)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamp(3)

  sender     User         @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User         @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@map("friends")
}

model panelDiscussion {
  id            Int       @id @default(autoincrement())
  link          String?
  topic         String?
}

enum Badges {
        Loyalty
        Pro
        Warrior
}
enum Certifications {
        TTC
        TOEFL
        IELTS
        Duolingo
}

model WordOfDay {
  id          Int      @id @default(autoincrement())
  word        String   @db.VarChar(255)
  definition  String   @db.Text
  example     String   @db.Text
  partOfSpeech String? @db.VarChar(50)
  updatedAt   DateTime @updatedAt  // Track when last updated
  
  @@map("words_of_day")
}

model PhrasalVerbOfDay {
  id          Int      @id @default(autoincrement())
  phrasalVerb String   @db.VarChar(255)
  definition  String   @db.Text
  example     String   @db.Text
  updatedAt   DateTime @updatedAt
  
  @@map("phrasal_verbs_of_day")
}

model MarqueeText {
  id        Int      @id @default(autoincrement())
  text      String   @db.VarChar(500)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  @@map("marquee_texts")
}

model OTP {
  id          Int    @id @default(autoincrement())
  phone       String
  code        String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  userId      Int?      @unique
  user        User?     @relation(fields: [userId], references: [id])
  isUsed      Boolean   @default(false)

  @@index([phone])
  @@index([expiresAt])
}

model Wallet {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique @map("user_id")
  balance    BigInt    @default(250000)
  lastCharge BigInt    @default(0)
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
   
  transactions      Transaction[] 
  user       User      @relation(fields: [userId],references: [id],onDelete: Cascade)

  @@map("wallets")
}

enum FluencyLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}



enum Role {
  Admin
  Teacher
  Client
}

enum TicketStatus {
  Open
  InProgress
  Resolved
  Closed
}

enum TicketPriority {
  Low
  Medium
  High
  Urgent
}

enum TicketCategory {
  Technical
  Payment
  Content
  Certificate
  General
}

model Ticket {
  id          Int             @id @default(autoincrement())
  title       String          @db.VarChar(200)
  message     String          @db.Text
  status      TicketStatus    @default(Open)
  priority    TicketPriority  @default(Medium)
  category    TicketCategory  @default(General)
  attachment  String?         @db.VarChar(500)
  userId      Int             @map("user_id")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamp(3)

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies     TicketReply[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("tickets")
}

model TicketReply {
  id        Int       @id @default(autoincrement())
  message   String    @db.Text
  isAdmin   Boolean   @default(false) @map("is_admin")
  userName  String    @map("user_name") @db.VarChar(100)
  ticketId  Int       @map("ticket_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)

  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_replies")
}



model Session {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  sessionDate       DateTime  @map("session_date") @db.Date
  startTime         DateTime  @map("start_time") @db.Time(0)
  language          String    @default("English") @db.VarChar(50)
  reasonForLearning String?   @map("reason_for_learning") @db.Text
  status            SessionStatus  @map("session_status")  @default(Pending) 
  meetUrl           String?   @map("meet_url") @db.VarChar(500)
  meetingId         String?   @map("meeting_id") @db.VarChar(100)
  sessionNote       String?   @map("session_note") @db.VarChar(255)
  amountPaid        BigInt    @map("amount_paid") @default(0)
  paymentStatus     String    @default("pending") @map("payment_status") @db.VarChar(20)
  requestedAt       DateTime  @default(now()) @map("requested_at") @db.Timestamp(3)
  approvedAt        DateTime? @map("approved_at") @db.Timestamp(3)
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamp(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
  sessionType       SessionType @map("session_type")  @default(Private)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionAuditLog   SessionAuditLog[]

  @@index([userId, status])
  @@index([sessionDate])
  @@index([status])
  @@map("sessions")
}

enum SessionStatus {
      Pending
      Approved
      Canceled
}

enum SessionType {
  Private
  Public
}

model SessionPrice {
    id              Int       @id @default(autoincrement())
    privatePrice    BigInt    @map("private_price") @default(350000) 
    subscriptionPrice   BigInt @map("subscription_price") @default(50000)
    discountPercent Int       @map("discount_percent") @default(0)
}

model Transaction {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  walletId       Int?       @map("wallet_id")
  amount          BigInt    @default(0)
  balanceBefore   BigInt    @map("balance_before") @default(0)
  balanceAfter    BigInt    @map("balance_after") @default(0)
  description     String?   @db.VarChar(255)
  referenceId     String?   @map("reference_id") @db.VarChar(100)
  paymentMethod   String?   @map("payment_method") @db.VarChar(50)
  status          String    @default("pending") @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  completedAt     DateTime? @map("completed_at") @db.Timestamp(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([walletId])
  @@map("transactions")
}


model SessionAuditLog {
  id        Int       @id @default(autoincrement())
  sessionId Int       @map("session_id")
  userId    Int       @map("user_id")
  oldStatus String?   @map("old_status") @db.VarChar(50)
  newStatus String?   @map("new_status") @db.VarChar(50)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_audit_log")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId  Int      @map("user_id")
  type      String    @db.VarChar(20)
  title     String    @db.VarChar(200)
  message   String    @db.Text
  read      Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model NotebookNote {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  localId   String   @map("local_id") @db.VarChar(64)
  text      String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localId])
  @@map("notebook_notes")
}

enum PostStatus {
  Draft
  Published
}

model Post {
  id           Int        @id @default(autoincrement())
  title        String     @db.VarChar(200)
  slug         String     @unique @db.VarChar(240)
  content      String     @db.Text
  thumbnailUrl String?    @map("thumbnail_url") @db.VarChar(500)
  thumbnailGradient String? @map("thumbnail_gradient") @db.VarChar(500)
  tags         String[]   @default([])
  status       PostStatus @default(Draft)
  authorId     Int        @map("author_id")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamp(3)
  publishedAt  DateTime?  @map("published_at") @db.Timestamp(3)

  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@map("posts")
}

model Mentor {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  title        String?  @db.VarChar(200)
  photoUrl     String?  @db.VarChar(500)
  bio          String?  @db.Text
  certifications String[] @default([])
  languages    String[] @default([])
  experience   String?  @db.VarChar(500)
  education    String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  @@map("mentors")
}

model SiteStatus {
  id        Int      @id @default(1)
  shutdown  Boolean  @default(false)
  updating  Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  @@map("site_status")
}
