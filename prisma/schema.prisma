// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model User {
  id            Int       @id @default(autoincrement())
  userUuid      String    @map("user_uuid") @unique @default(uuid())
  fullname      String    @db.VarChar(100)
  email         String    @unique @db.VarChar(100)
  phone         String    @unique @db.VarChar(11)
  dateOfBirth   DateTime  @map("date_of_birth") @db.Date
  fluencyLevel  FluencyLevel    @map("fluency_level") 
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  isVerified    Boolean   @default(false) @map("is_verified")
  isActive      Boolean   @default(true) @map("is_active")
  role          Role    @default(Client) 
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")
  userId        Int       @unique
  wallet        Wallet?
  otp           OTP?
  sessions          Session[]
  transactions      Transaction[]
  sessionAuditLog   SessionAuditLog[]

  @@map("users")
}


model OTP {
  id          Int    @id @default(autoincrement())
  phone       String
  code        String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  userId      Int?      @unique
  user        User?     @relation(fields: [userId], references: [id])
  isUsed      Boolean   @default(false)

  @@index([phone])
  @@index([expiresAt])
}

model Wallet {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique @map("user_id")
  balance    BigInt    @default(0)
  lastCharge BigInt    @default(0)
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
   
  transactions      Transaction[] 
  user       User      @relation(fields: [userId],references: [id],onDelete: Cascade)

  @@map("wallets")
}

enum FluencyLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum Role {
  Admin
  Teacher
  Client
}



model Session {
  id                Int       @id @default(autoincrement())
  userUuid          String    @map("user_uuid")
  sessionDate       DateTime  @map("session_date") @db.Date
  startTime         DateTime  @map("start_time") @db.Time(0)
  language          String    @default("English") @db.VarChar(50)
  reasonForLearning String?   @map("reason_for_learning") @db.Text
  status            String    @default("pending") @db.VarChar(20)
  meetUrl           String?   @map("meet_url") @db.VarChar(500)
  meetingId         String?   @map("meeting_id") @db.VarChar(100)
  sessionNote       String?   @map("session_note") @db.VarChar(255)
  amountPaid        BigInt    @map("amount_paid") @default(0)
  paymentStatus     String    @default("pending") @map("payment_status") @db.VarChar(20)
  requestedAt       DateTime  @default(now()) @map("requested_at") @db.Timestamp(3)
  approvedAt        DateTime? @map("approved_at") @db.Timestamp(3)
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamp(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
  sessionType       SessionType
  user              User              @relation(fields: [userUuid], references: [userUuid], onDelete: Cascade)

  sessionAuditLog   SessionAuditLog[]

  @@index([userUuid, status])
  @@index([sessionDate])
  @@index([status])
  @@map("sessions")
}


enum SessionType {
  Private
  Public
}
model Transaction {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  walletId       Int?       @map("wallet_id")
  amount          BigInt    @default(0)
  balanceBefore   Decimal   @map("balance_before") @db.Decimal(10, 2)
  balanceAfter    Decimal   @map("balance_after") @db.Decimal(10, 2)
  description     String?   @db.VarChar(255)
  referenceId     String?   @map("reference_id") @db.VarChar(100)
  paymentMethod   String?   @map("payment_method") @db.VarChar(50)
  status          String    @default("pending") @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  completedAt     DateTime? @map("completed_at") @db.Timestamp(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([walletId])
  @@map("transactions")
}


model SessionAuditLog {
  id        Int       @id @default(autoincrement())
  sessionId Int       @map("session_id")
  userId    Int       @map("user_id")
  oldStatus String?   @map("old_status") @db.VarChar(50)
  newStatus String?   @map("new_status") @db.VarChar(50)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_audit_log")
}
